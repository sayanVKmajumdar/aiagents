# Copy to .env (never commit the real file) or paste into Render/Fly env vars.

# Google/YouTube Music OAuth token, as a single-line JSON blob:
#   cd backend && ytmusicapi oauth && cat oauth.json | tr -d '\n'
YTMUSIC_OAUTH_JSON=

# Optional shared secret. When set, /get-alarm-audio and /search require
# `x-api-key: <value>` (or ?api_key=). /health stays public.
ALARM_API_KEY=

# Comma or space separated yt-dlp player clients. The mobile clients survive
# datacenter IPs far better than the default web client.
YTDLP_PLAYER_CLIENTS=android ios tv_embedded

# Country used for the public charts fallback.
CHARTS_COUNTRY=US

# How long resolved stream URLs are cached, in seconds (URLs expire ~6h;
# shorter = fresher, longer = fewer YouTube calls).
STREAM_CACHE_TTL=1800

# CORS origins. "*" is fine for a personal app; restrict if you embed the API.
CORS_ALLOW_ORIGINS=*

# Only useful locally, e.g. chrome — yt-dlp reads your browser cookies.
# YTDLP_COOKIES_FROM_BROWSER=
