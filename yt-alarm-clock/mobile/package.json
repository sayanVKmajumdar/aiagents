{
  "name": "yt-alarm-clock",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "npx --yes eslint@8 src App.js --ext .js",
    "typecheck": "npx --yes typescript@5 tsc --noEmit --allowJs --checkJs --jsx react-jsx --moduleResolution bundler --module esnext --target es2020 App.js \"src/**/*.js\" 2>/dev/null || true",
    "build:apk": "eas build -p android --profile preview",
    "build:prod": "eas build -p android --profile production",
    "test": "jest --config jest.config.js",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-keep-awake": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "~54.0.6",
    "babel-preset-expo": "~54.0.12",
    "jest": "^29.7.0"
  }
}
